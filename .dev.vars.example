# Copy this file to .dev.vars and use Railway's public PostgreSQL URL locally.
# Never commit the real value.
DATABASE_URL="postgresql://postgres:password@host:port/railway"
DATABASE_POOL_MAX="5"

# Google Drive backups (server-side only)
# Optional: defaults to enabled; set false only to intentionally disable backups.
GOOGLE_DRIVE_BACKUP_ENABLED="true"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/settings/backup/google/callback"
GOOGLE_TOKEN_ENCRYPTION_KEY=""

# Used by the separate Railway cron service
MECARDEE_APP_URL="http://localhost:3000"
BACKUP_CRON_SECRET=""
